MEMORY_HUB_HOST=127.0.0.1
MEMORY_HUB_PORT=8787
MEMORY_HUB_PUBLIC_URL=https://memory.example.com
MEMORY_HUB_DATA_DIR=/var/lib/sully-memory-hub
MEMORY_HUB_TOKEN=change-this-long-random-token
MEMORY_HUB_ALLOWED_ORIGINS=https://memory.example.com,https://sully.example.com
MEMORY_HUB_MESSAGE_TEXT_MAX_BYTES=65536
MEMORY_HUB_INLINE_MEDIA_MAX_BYTES=1048576
MEMORY_HUB_MESSAGE_JSON_MAX_BYTES=2097152
MEMORY_HUB_STORAGE_QUOTA_BYTES=10737418240
MEMORY_HUB_ACTION_RUNTIME_ENABLED=true
MEMORY_HUB_ACTION_RUNTIME_INTERVAL_MS=5000
# shadow authority: legacy reads by default; compare runs background parity; v2 requires startup parity. Persisted V2 authority always keeps V2 reads after restart.
MEMORY_HUB_RUNTIME_READ_MODE=legacy
MEMORY_HUB_RUNTIME_PARITY_INTERVAL_MS=900000
# Keep false until V2 runtime reads and persisted authority_mode have both been explicitly promoted. Native writes require effective read mode v2.
MEMORY_HUB_RUNTIME_NATIVE_WRITES_ENABLED=false

# Start cc-runner only after the real database has been explicitly promoted to V2 authority.
# The runner inherits MEMORY_HUB_URL/TOKEN and its Claude child inherits the same values for MCP.
MEMORY_HUB_URL=http://127.0.0.1:8787
CC_RUNNER_CLAUDE_COMMAND=claude
CC_RUNNER_CLAUDE_MODEL=
CC_RUNNER_PERMISSION_MODE=default
CC_RUNNER_CHARACTER_ID=
CC_RUNNER_WORKSPACE=/var/lib/sully-memory-hub/claude-workspace
CC_RUNNER_STATE_DIR=/var/lib/sully-memory-hub/cc-runner
CC_RUNNER_POLL_MS=10000
CC_RUNNER_LEASE_MS=1200000
CC_RUNNER_MAX_ATTEMPTS=3

SULLYOS_EXPORT_BASE_URL=https://sully.example.com
OMBRE_SULLY_BRIDGE_URL=https://ombre.example.com
OMBRE_SULLY_BRIDGE_KEY=change-this-ombre-bridge-key

# OpenAI-compatible embedding endpoint. If set, VPS uses this without exposing the key to the browser.
EMBEDDING_SOURCE=env
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=change-this-embedding-key
EMBEDDING_MODEL=text-embedding-model
EMBEDDING_DIMENSIONS=1024
